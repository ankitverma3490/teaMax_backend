# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL connection string)
# Replace credentials with your PostgreSQL instance (e.g. Supabase, Neon, Railway, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamax_db?schema=public"

# Authentication & Security
JWT_SECRET="teamax_ultra_secure_jwt_secret_token_replace_in_prod_2026"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (Comma-separated for admin panel and client website)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:3001"

# Cloudinary Image Storage & Management
 CLOUDINARY_CLOUD_NAME=teamax
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_regenerated_api_secret

